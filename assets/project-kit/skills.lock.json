{
  "schema_version": 1,
  "policy_version": "0.1.0",
  "allowed_sources": {
    "registries": [
      "https://www.skills.sh"
    ],
    "official_repositories": [
      "https://github.com/anthropics/skills",
      "https://github.com/openai/skills"
    ],
    "official_documentation": [
      "https://code.claude.com/docs/en/skills",
      "https://developers.openai.com",
      "https://learn.chatgpt.com/docs/build-skills"
    ],
    "extra": []
  },
  "review_policy": {
    "review_interval_days": 60,
    "auto_update": false,
    "max_third_party_skills_per_node": 2,
    "reevaluate_on": [
      "explicit_scheme_check",
      "repeated_node_failure",
      "model_or_effort_change",
      "stack_or_architecture_change",
      "devflow_upgrade",
      "pinned_skill_change",
      "review_after_due"
    ]
  },
  "skills": [],
  "node_decisions": {}
}
