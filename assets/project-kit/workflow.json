{
  "schema_version": 1,
  "workflow_version": "0.1.0",
  "entry_node": "inspect_project",
  "terminal_nodes": ["done", "blocked", "human_needed"],
  "allowed_cycles": [
    {
      "id": "correction-loop",
      "nodes": ["quality_gates", "fix_findings", "implementer_review", "final_review"],
      "max_traversals": 2,
      "on_exhausted": "human_needed"
    }
  ],
  "nodes": [
    {
      "id": "inspect_project",
      "stage": "setup",
      "state": "INSPECTING",
      "entry_condition": "request.received",
      "action": "inspect_repository_and_capture_baseline",
      "role": "architect",
      "permissions": "read-only",
      "competencies": ["repository inspection", "stack detection", "risk discovery"],
      "inputs": ["repository", "current rules"],
      "expected_evidence": ["inspection report", "baseline status"],
      "checks": ["inspection caused no project changes"],
      "timeout_minutes": 30
    },
    {
      "id": "product_scope_gate",
      "stage": "planning",
      "state": "AWAITING_SCOPE",
      "entry_condition": "inspection.complete",
      "action": "verify_product_scope_and_decision_authority",
      "role": "product-lead",
      "permissions": "read-and-propose",
      "competencies": ["product scope", "decision boundaries"],
      "inputs": ["product strategy", "latest PM decisions"],
      "expected_evidence": ["scope reference", "GO or approved development scope"],
      "checks": ["no unapproved product decision"],
      "timeout_minutes": 30
    },
    {
      "id": "design",
      "stage": "planning",
      "state": "DESIGNING",
      "entry_condition": "scope.approved",
      "action": "produce_architecture_decision_and_test_specification",
      "role": "architect",
      "permissions": "read-and-propose",
      "competencies": ["solution design", "architecture impact assessment", "test specification"],
      "inputs": ["approved scope", "inspection report", "architecture", "canonical documents"],
      "expected_evidence": ["design decision", "test spec", "issue draft"],
      "checks": [
        "no unresolved product choice",
        "ADR recorded when architecture impact is real",
        "proposal is proportional to the project"
      ],
      "timeout_minutes": 45
    },
    {
      "id": "prepare_issue",
      "stage": "planning",
      "state": "PREPARING_ISSUE",
      "entry_condition": "design.complete",
      "action": "prepare_ready_issue_and_risk_based_checks",
      "role": "product-lead",
      "permissions": "github-issue-write",
      "competencies": ["issue decomposition", "acceptance criteria", "risk classification"],
      "inputs": ["roadmap", "architecture", "product rules", "design decision"],
      "expected_evidence": ["ready issue", "acceptance-to-check map", "architecture impact decision"],
      "checks": [
        "definition of ready",
        "one issue one branch one PR",
        "scope covers one feature or an explicitly bounded small batch in one place",
        "architecture impact references the design decision instead of being made here"
      ],
      "timeout_minutes": 45
    },
    {
      "id": "skill_preflight",
      "stage": "planning",
      "state": "VERIFYING_SKILLS",
      "entry_condition": "issue.ready",
      "action": "verify_node_skill_decisions_and_integrity",
      "role": "architect",
      "permissions": "read-only",
      "competencies": ["skill necessity assessment", "skill integrity"],
      "inputs": ["skills lock", "node assignments", "execution profile"],
      "expected_evidence": ["explicit decision for every active node", "matching checksums"],
      "checks": ["no unresolved skill decision", "required skills available to background agent"],
      "timeout_minutes": 15
    },
    {
      "id": "tdd_red",
      "stage": "implementation",
      "state": "RED",
      "entry_condition": "skills.verified",
      "action": "add_or_select_failing_test_for_behavior_change",
      "role": "implementer",
      "permissions": "workspace-write-no-merge",
      "competencies": ["test design", "characterization testing", "TDD"],
      "inputs": ["ready issue", "baseline", "assigned skills"],
      "expected_evidence": ["failing test before implementation", "failure reason"],
      "checks": ["test fails for intended reason", "guardrails unchanged"],
      "timeout_minutes": 60
    },
    {
      "id": "implement",
      "stage": "implementation",
      "state": "GREEN_REFACTOR",
      "entry_condition": "red.proven",
      "action": "implement_minimal_scope_then_refactor",
      "role": "implementer",
      "permissions": "workspace-write-no-merge",
      "competencies": ["stack implementation", "refactoring", "documentation"],
      "inputs": ["ready issue", "failing test", "assigned skills"],
      "expected_evidence": ["passing targeted tests", "implementation diff", "updated architecture docs when required"],
      "checks": ["scope unchanged", "no weakened tests or thresholds"],
      "timeout_minutes": 180
    },
    {
      "id": "quality_gates",
      "stage": "verification",
      "state": "VERIFYING",
      "entry_condition": "implementation.complete",
      "action": "run_risk_based_quality_gates",
      "role": "qa",
      "permissions": "verify-read-only",
      "competencies": ["test execution", "security checks", "evidence capture"],
      "inputs": ["head SHA", "quality profile", "acceptance-to-check map"],
      "expected_evidence": ["required checks", "coverage comparison", "evidence bound to head SHA"],
      "checks": ["all required checks green", "baseline not weakened"],
      "timeout_minutes": 90
    },
    {
      "id": "fix_findings",
      "stage": "implementation",
      "state": "FIXING",
      "entry_condition": "fix.requested",
      "action": "fix_full_class_of_verified_findings",
      "role": "implementer",
      "permissions": "workspace-write-no-merge",
      "competencies": ["debugging", "root cause analysis", "regression prevention"],
      "inputs": ["verified findings", "current head SHA"],
      "expected_evidence": ["root cause", "regression test", "new head SHA"],
      "checks": ["blocking class fixed", "new evidence invalidates old approval"],
      "timeout_minutes": 120
    },
    {
      "id": "implementer_review",
      "stage": "review",
      "state": "SELF_REVIEW",
      "entry_condition": "quality.passed",
      "action": "perform_implementer_review_without_changing_scope",
      "role": "implementer",
      "permissions": "workspace-write-no-merge",
      "competencies": ["code review", "defect class search"],
      "inputs": ["diff", "issue", "evidence"],
      "expected_evidence": ["self-review report", "resolved findings"],
      "evidence_contract": {
        "self-review report": {"kind": "findings", "required": true}
      },
      "checks": ["issue criteria rechecked"],
      "timeout_minutes": 45
    },
    {
      "id": "final_review",
      "stage": "review",
      "state": "FINAL_REVIEW",
      "entry_condition": "self_review.passed",
      "action": "review_issue_architecture_policy_and_evidence",
      "role": "reviewer",
      "permissions": "review-and-github",
      "competencies": ["independent code review", "architecture", "product policy"],
      "inputs": ["PR", "issue", "current head SHA", "evidence"],
      "expected_evidence": ["review verdict bound to head SHA", "closed blocking threads"],
      "evidence_contract": {
        "review verdict bound to head SHA": {"kind": "review", "required": true}
      },
      "checks": [
        "scope matches issue",
        "architecture docs current",
        "no unsupported claims",
        "solution matches the declared project scale and its complexity budget"
      ],
      "timeout_minutes": 90
    },
    {
      "id": "merge_gate",
      "stage": "release",
      "state": "MERGE_GATE",
      "entry_condition": "final_review.approved",
      "action": "verify_current_head_and_required_checks",
      "role": "release-operator",
      "permissions": "merge-verified-sha",
      "competencies": ["GitHub state verification", "merge safety"],
      "inputs": ["PR head SHA", "approval SHA", "required checks"],
      "expected_evidence": ["verified_head_sha", "required_checks_green", "approval_matches_head_sha"],
      "checks": ["no merge on stale approval", "no unresolved blocking thread"],
      "timeout_minutes": 20
    },
    {
      "id": "merge",
      "stage": "release",
      "state": "MERGING",
      "entry_condition": "merge_gate.passed",
      "action": "merge_exact_verified_head_using_repository_policy",
      "role": "release-operator",
      "permissions": "merge-verified-sha",
      "competencies": ["safe merge operation"],
      "inputs": ["verified head SHA", "repository merge policy"],
      "expected_evidence": ["merge commit SHA", "closed issue when complete"],
      "checks": ["exact verified SHA merged"],
      "timeout_minutes": 15
    },
    {
      "id": "post_merge",
      "stage": "release",
      "state": "POST_MERGE_VERIFY",
      "entry_condition": "merge.complete",
      "action": "run_required_post_merge_or_deploy_checks",
      "role": "qa",
      "permissions": "verify-read-only",
      "competencies": ["smoke testing", "deploy verification"],
      "inputs": ["merge SHA", "release policy"],
      "expected_evidence": ["post-merge result", "release identifier when applicable"],
      "checks": ["only required checks run", "failure is visible"],
      "timeout_minutes": 60
    },
    {
      "id": "done",
      "stage": "terminal",
      "state": "DONE",
      "entry_condition": "post_merge.passed",
      "action": "record_completion_and_notify_on_state_change",
      "role": "product-lead",
      "permissions": "report-only",
      "competencies": ["status communication"],
      "inputs": ["run evidence"],
      "expected_evidence": ["final run record"],
      "checks": ["no hidden failure"],
      "timeout_minutes": 10
    },
    {
      "id": "blocked",
      "stage": "terminal",
      "state": "BLOCKED",
      "entry_condition": "non_human_blocker.detected",
      "action": "record_exact_blocker_and_safe_next_action",
      "role": "product-lead",
      "permissions": "report-only",
      "competencies": ["blocker diagnosis"],
      "inputs": ["failure evidence"],
      "expected_evidence": ["blocker", "attempted safe options", "next action"],
      "checks": ["no simulated success"],
      "timeout_minutes": 10
    },
    {
      "id": "human_needed",
      "stage": "terminal",
      "state": "HUMAN_NEEDED",
      "entry_condition": "human_decision.required",
      "action": "ask_one_concrete_decision_with_options_and_consequences",
      "role": "human-pm",
      "permissions": "human-approval",
      "competencies": ["product decision", "risk acceptance", "access approval"],
      "inputs": ["decision package"],
      "expected_evidence": ["explicit human decision"],
      "checks": ["question cannot be answered from existing sources"],
      "timeout_minutes": 0
    }
  ],
  "edges": [
    {"from": "inspect_project", "to": "product_scope_gate", "condition": "inspection.complete", "max_retries": 0, "on_failure": "blocked"},
    {"from": "product_scope_gate", "to": "design", "condition": "scope.approved", "max_retries": 0, "on_failure": "human_needed"},
    {"from": "product_scope_gate", "to": "human_needed", "condition": "scope.decision_required", "max_retries": 0, "on_failure": "human_needed"},
    {"from": "design", "to": "prepare_issue", "condition": "design.complete", "max_retries": 1, "on_failure": "human_needed"},
    {"from": "design", "to": "human_needed", "condition": "design.decision_required", "max_retries": 0, "on_failure": "human_needed"},
    {"from": "prepare_issue", "to": "skill_preflight", "condition": "issue.ready", "max_retries": 1, "on_failure": "human_needed"},
    {"from": "skill_preflight", "to": "tdd_red", "condition": "skills.verified", "max_retries": 1, "on_failure": "blocked"},
    {"from": "tdd_red", "to": "implement", "condition": "red.proven", "max_retries": 2, "on_failure": "human_needed"},
    {"from": "implement", "to": "quality_gates", "condition": "implementation.complete", "max_retries": 2, "on_failure": "human_needed"},
    {"from": "quality_gates", "to": "implementer_review", "condition": "quality.passed", "max_retries": 0, "on_failure": "fix_findings"},
    {"from": "quality_gates", "to": "fix_findings", "condition": "quality.failed", "max_retries": 2, "on_failure": "human_needed"},
    {"from": "fix_findings", "to": "quality_gates", "condition": "fix.complete", "max_retries": 2, "on_failure": "human_needed"},
    {"from": "implementer_review", "to": "final_review", "condition": "self_review.passed", "max_retries": 1, "on_failure": "fix_findings"},
    {"from": "final_review", "to": "merge_gate", "condition": "final_review.approved", "max_retries": 0, "on_failure": "fix_findings"},
    {"from": "final_review", "to": "fix_findings", "condition": "changes.requested", "max_retries": 2, "on_failure": "human_needed"},
    {"from": "merge_gate", "to": "merge", "condition": "merge_gate.passed", "max_retries": 0, "on_failure": "blocked"},
    {"from": "merge", "to": "post_merge", "condition": "merge.complete", "max_retries": 0, "on_failure": "blocked"},
    {"from": "post_merge", "to": "done", "condition": "post_merge.passed", "max_retries": 1, "on_failure": "blocked"},
    {"from": "post_merge", "to": "blocked", "condition": "post_merge.failed", "max_retries": 1, "on_failure": "blocked"}
  ]
}
