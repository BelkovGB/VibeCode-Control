{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/workflow.schema.json",
  "title": "VibeCode Control state graph",
  "type": "object",
  "required": ["schema_version", "workflow_version", "entry_node", "terminal_nodes", "allowed_cycles", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "entry_node": {"type": "string", "minLength": 1},
    "terminal_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "allowed_cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodes", "max_traversals", "on_exhausted"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "max_traversals": {"type": "integer", "minimum": 1, "maximum": 10},
          "on_exhausted": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "stage", "state", "entry_condition", "action", "role", "permissions",
          "competencies", "inputs", "expected_evidence", "checks", "timeout_minutes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "stage": {"type": "string"},
          "state": {"type": "string"},
          "entry_condition": {"type": "string"},
          "action": {"type": "string"},
          "role": {"type": "string"},
          "permissions": {"type": "string"},
          "competencies": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "checks": {"type": "array", "items": {"type": "string"}},
          "timeout_minutes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "condition", "max_retries", "on_failure"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "condition": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
          "on_failure": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
