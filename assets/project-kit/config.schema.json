{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/config.schema.json",
  "title": "VibeCode Control project configuration",
  "type": "object",
  "required": ["schema_version", "devflow_version", "project", "policy", "roles", "quality", "github", "automation"],
  "properties": {
    "schema_version": {"const": 1},
    "devflow_version": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["name", "mode", "product_stage", "repository_type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mode": {"enum": ["unconfigured", "init", "adopt"]},
        "product_stage": {
          "enum": ["unassessed", "hypothesis-research", "product-definition", "development-readiness", "development", "maintenance"]
        },
        "decision_ref": {"type": "string"},
        "repository_type": {"type": "string"},
        "scale": {"$ref": "#/$defs/projectScale"},
        "scale_profiles": {"type": "object"}
      },
      "additionalProperties": true
    },
    "policy": {"type": "object"},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["agent", "model", "effort", "permissions"],
        "properties": {
          "agent": {"type": "string", "minLength": 1},
          "model": {"$ref": "#/$defs/typedParameter"},
          "effort": {"$ref": "#/$defs/typedParameter"},
          "permissions": {"type": "string", "minLength": 1}
        }
      }
    },
    "node_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {"type": "string", "minLength": 1},
          "model": {"$ref": "#/$defs/typedParameter"},
          "effort": {"$ref": "#/$defs/typedParameter"},
          "permissions": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "clients": {
      "type": "object",
      "description": "Optional extension of the engine client-adapter registry. The shipped kit carries no block.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agents": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "project_skill_root": {"type": "string", "minLength": 1},
          "personal_skill_root": {"type": "string", "minLength": 1},
          "managed_instructions": {"type": "string", "minLength": 1},
          "effort": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "models": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "models": {"type": "object"},
    "quality": {"type": "object"},
    "github": {"type": "object"},
    "automation": {
      "type": "object",
      "properties": {
        "pipeline": {"$ref": "#/$defs/pipelineBudget"},
        "sessions": {"$ref": "#/$defs/sessionTransport"}
      },
      "additionalProperties": true
    },
    "telemetry": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "projectScale": {
      "title": "Project scale profile",
      "description": "Which scale profile this project declares. The profile carries a complexity budget the CLI prints but never measures, and gate defaults the CLI does compare. Choosing a scale is a PM decision, so `explicit` always names the decision that authorized it — including the first choice — and changing the profile under the same reference is refused as a silent rescale. `undecided` is what the neutral template ships and blocks the context setup stage.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "value", "decision_ref"],
          "properties": {
            "mode": {"const": "explicit"},
            "value": {"type": "string", "minLength": 1},
            "decision_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "undecided"}},
          "additionalProperties": false
        }
      ]
    },
    "sessionTransport": {
      "title": "Session transport registry",
      "description": "Which pre-created chat session executes which role. Sessions are a transport, not a source of truth: the CLI never sees them, so this records what the owner declared. `undecided` is what the neutral template ships and blocks setup; `not-applicable` is a decision that this project runs no sessions. Under `explicit` the client must be an adapter that declares `session_messaging`, and every role name must exist in `config.roles`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["not-applicable", "undecided"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "client"],
          "properties": {
            "mode": {"const": "explicit"},
            "client": {"type": "string", "minLength": 1},
            "roles": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/sessionRole"}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sessionRole": {
      "title": "Role to session binding",
      "description": "The name of a chat session the owner created beforehand. `not-applicable` means this role is not executed through a session; `undecided` means nobody has chosen yet.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "session"],
          "properties": {
            "mode": {"const": "explicit"},
            "session": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["not-applicable", "undecided"]}},
          "additionalProperties": false
        }
      ]
    },
    "pipelineBudget": {
      "title": "Autonomous chain budget",
      "description": "Bounds how many tasks the coordinator may run in a row. `manual` runs nothing autonomously and is the shipped default. `count` and `until` are PM decisions and therefore require a non-empty decision_ref; changing the mode or value under the same reference is refused as a silent extension.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "manual"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "value", "decision_ref"],
          "properties": {
            "mode": {"const": "count"},
            "value": {"type": "integer", "minimum": 1},
            "decision_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "value", "decision_ref"],
          "properties": {
            "mode": {"const": "until"},
            "value": {"type": "string", "minLength": 1},
            "decision_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "typedParameter": {
      "title": "Typed execution parameter",
      "description": "A model or effort parameter always states its mode. `undecided` means nobody has chosen yet and is what the neutral template ships; it blocks setup and execution. `unset` means the project owner decided the parameter is absent; it does not block. Neither is ever materialized into a concrete value. A bare string is the legacy spelling, accepted on read and normalized on write.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "value"],
          "properties": {
            "mode": {"const": "explicit"},
            "value": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["inherited", "unset", "not-applicable", "undecided"]}
          },
          "additionalProperties": false
        },
        {"type": "string", "minLength": 1, "deprecated": true}
      ]
    }
  }
}
