{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/config.schema.json",
  "title": "VibeCode Control project configuration",
  "type": "object",
  "required": ["schema_version", "devflow_version", "project", "policy", "roles", "quality", "github", "automation"],
  "properties": {
    "schema_version": {"const": 1},
    "devflow_version": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["name", "mode", "product_stage", "repository_type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mode": {"enum": ["unconfigured", "init", "adopt"]},
        "product_stage": {
          "enum": ["unassessed", "hypothesis-research", "product-definition", "development-readiness", "development", "maintenance"]
        },
        "decision_ref": {"type": "string"},
        "repository_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "policy": {"type": "object"},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["agent", "model", "effort", "permissions"],
        "properties": {
          "agent": {"type": "string", "minLength": 1},
          "model": {"$ref": "#/$defs/typedParameter"},
          "effort": {"$ref": "#/$defs/typedParameter"},
          "permissions": {"type": "string", "minLength": 1}
        }
      }
    },
    "node_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {"type": "string", "minLength": 1},
          "model": {"$ref": "#/$defs/typedParameter"},
          "effort": {"$ref": "#/$defs/typedParameter"},
          "permissions": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "models": {"type": "object"},
    "quality": {"type": "object"},
    "github": {"type": "object"},
    "automation": {"type": "object"},
    "telemetry": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "typedParameter": {
      "title": "Typed execution parameter",
      "description": "A model or effort parameter always states its mode. `undecided` means nobody has chosen yet and is what the neutral template ships; it blocks setup and execution. `unset` means the project owner decided the parameter is absent; it does not block. Neither is ever materialized into a concrete value. A bare string is the legacy spelling, accepted on read and normalized on write.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "value"],
          "properties": {
            "mode": {"const": "explicit"},
            "value": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["inherited", "unset", "not-applicable", "undecided"]}
          },
          "additionalProperties": false
        },
        {"type": "string", "minLength": 1, "deprecated": true}
      ]
    }
  }
}
